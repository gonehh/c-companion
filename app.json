{
  "expo": {
    "name": "Code Loom",
    "slug": "cpp-quest",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cppquest",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "hidden": true,
      "barStyle": "light-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.cppquest.app"
    },
    "android": {
      "package": "dev.cppquest.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light",
          "enforceContrast": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
